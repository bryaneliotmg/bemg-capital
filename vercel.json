{
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "functions": {
    "api/cron/sync-grants.ts": { "maxDuration": 60 },
    "api/search-grants.ts": { "maxDuration": 60 }
  },
  "crons": [{ "path": "/api/cron/sync-grants", "schedule": "0 6 * * *" }],
  "rewrites": [{ "source": "/((?!api/).*)", "destination": "/index.html" }]
}
